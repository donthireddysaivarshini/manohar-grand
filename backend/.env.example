# ==========================================
# Manohar Grand Hotel — Backend Configuration
# ==========================================

# Django Security
DJANGO_SECRET_KEY=django-insecure-development-key-change-in-production-12345
DJANGO_SETTINGS_MODULE=manohar_grand.settings.development
DEBUG=True

# Host & Origin Whitelist (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay Payment Gateway (Test/Sandbox Credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# Database Configuration (Defaults to SQLite in development)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=manohar_grand_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
